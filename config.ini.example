# ShadowMountPlus main configuration: /data/shadowmount/config.ini
# Keep [config] version. Uncomment only settings you want to override.
# Individual game/image settings belong in profiles.ini (see profiles.ini.example).
# Boolean values: on/off, true/false, yes/no, 1/0.
# Quote values containing # or ;, or leading/trailing spaces.
# In quoted strings escape backslash as \\ and double quote as \".
# Web edits preserve unrelated settings and comments.

[config]
version = 2

[general]
# Debug output to console and /data/shadowmount/debug.log.
# debug = on
# Suppress ordinary informational notifications; errors still appear.
# quiet_mode = off
# Hide game file/installation operations in the web interface.
# child_mode = off
# auto uses the console language; locale examples: en-US, ru-RU.
# language = auto

[api]
# Disabling the API also skips Shell UI launcher installation at startup.
# enabled = on
# 127.0.0.1 restricts access to the console; default allows LAN access.
# bind_address = 0.0.0.0
# port = 10101

[scan]
# Depth 1: first-level subfolders; 2: one extra nested level.
# depth = 1
# Full scan interval: 1..3600 seconds.
# interval_seconds = 15
# Minimum source age: 0..3600 seconds.
# stability_wait_seconds = 10
# Repeat path to replace built-in scan roots. With no path, use built-in roots.
# Managed image roots are always added; /data/homebrew/backports stays a fallback.
# path = /data/homebrew
# path = /data/etaHEN/games

[mount]
# ro: read-only; rw: read-write.
# mode = ro
# Attempt mounting damaged filesystems.
# force = off
# Keep backing images mounted between launches. USB images still unmount for sleep.
# persistent_images = off
# Backends: lvd or md. Internal BFS exFAT fast path requires lvd and 64 KiB clusters.
# exfat_backend = lvd
# ufs_backend = lvd
# Cache the containing PFS compressed-file index before attaching nested images.
# nested_pfs_index_cache = off

[library]
# Batch registration. Default is off on all firmware, including 12.00+.
# install_all = off
# Remove registrations whose sources stay unavailable for the delay below.
# remove_missing = off
# Allow removal when installed DLC exists.
# remove_with_dlc = off
# Delay: 1..86400 seconds.
# remove_delay_seconds = 300

[ps4]
# Defaults for PS4 games without individual overrides. All default to off.
# Changes apply on the next launch; off leaves the game's stock behavior intact.
# force_pro = off
# cpu_boost = off
# gpu_boost = off
# 8 GB is per-game only; see profiles.ini.example.

[fakelib]
# Sandbox fakelib overlays. Disable the standalone BackPork payload when enabled.
# enabled = on
# full, emulators, disabled. Individual game profiles override this default.
# default_mode = full
# global_enabled = on
# global_path = /data/shadowmount/fakelib
# game: game-specific files win; global: global files win. fakelib2 stays exclusive.
# global_priority = game

[emulators]
# Replace matching cached game fakelib files from path; excludes fakelib2 and PKGs.
# update_enabled = on
# path = /data/shadowmount/emus
# Check for AMPR 30 seconds after startup, then every four hours; defer during games.
# auto_update_ampr = off
# ampr_update_url = https://github.com/drakmor/ampr_emu/releases/latest/download/libSceAmpr.sprx

[fan]
# system: keep the system target; 50..91: apply a temperature target at game launch.
# target_temperature = system

[patches]
# 0 = manual only (default), 1..8760 = automatic update interval in hours.
# update_interval_hours = 24
# With no source lines, the six built-in repositories are selected.
# Repeat source = cheats|ZIP_URL or patches|ZIP_URL to choose your own list.
# An empty source = disables all sources. Local files take priority.
# source = cheats|https://codeload.github.com/etaHEN/PS5_Cheats/zip/refs/heads/main
# source = patches|https://github.com/illusionyy/PS-Game-Patch/releases/latest/download/patch1.zip

[sectors]
# Logical device sector sizes, not filesystem clusters: powers of two, 512..1048576.
# BFS fast path uses lvd_exfat=512; the exFAT cluster size must be 65536.
# lvd_exfat = 512
# lvd_ufs = 4096
# lvd_pfs = 4096
# md_exfat = 512
# md_ufs = 4096

# Up to 16 SMB connections; each needs a unique name and path. Credentials are
# plaintext; protect this file and config-v1-backup. New files use mode 0600.
# Uncomment the section AND its fields to add a connection.
# [smb:NAS]
# path = smb://192.168.1.10/games
# username = "DOMAIN\\user"
# password = "change me"
# active = on
# read_only = off
